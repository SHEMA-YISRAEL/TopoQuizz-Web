---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SocialProof from '../components/SocialProof.astro';
import Stats from '../components/Stats.astro';
import Features from '../components/Features.astro';
import Screenshots from '../components/Screenshots.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Download from '../components/Download.astro';
import Footer from '../components/Footer.astro';

const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.topoquizz';
---

<Layout>
  <Header playStoreUrl={playStoreUrl} />
  <Hero playStoreUrl={playStoreUrl} />
  <Stats />
  <SocialProof />
  <Features />
  <Screenshots />
  <HowItWorks />
  <Download playStoreUrl={playStoreUrl} />
  <Footer playStoreUrl={playStoreUrl} />
</Layout>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(({ target, isIntersecting }) => {
      if (isIntersecting) {
        target.classList.add('visible');
        observer.unobserve(target);
      }
    });
  }, { threshold: 0.12 });

  const selectors = ['.sec-head', '.feat-card', '.stat', '.step', '.dl-left', '.social-card', '.social-empty', '.ss-item'];
  selectors.forEach(sel => {
    document.querySelectorAll(sel).forEach((el, i) => {
      el.classList.add('anim-item');
      (el as HTMLElement).style.transitionDelay = `${(i % 6) * 0.1}s`;
      observer.observe(el);
    });
  });
</script>
