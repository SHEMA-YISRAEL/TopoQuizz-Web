---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Ruleta Médica — TopoQuizz" description="Juego de ruleta médica para estudiantes de medicina.">

<style is:global>
  /* override body bg for this page */
  body {
    background: linear-gradient(135deg, #1a2535 0%, #283143 50%, #1e3a5f 100%) !important;
    min-height: 100vh;
  }

  /* ── BOTONES GLOBALES (aplican a elementos dinámicos también) ── */
  .rbtn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    padding: 13px 24px; border-radius: 16px;
    font-family: "Plus Jakarta Sans", Inter, sans-serif;
    font-weight: 700; font-size: 14px; letter-spacing: 0.3px;
    cursor: pointer; border: none;
    transition: transform 0.18s cubic-bezier(.34,1.56,.64,1), box-shadow 0.18s, background 0.18s;
    position: relative; overflow: hidden;
  }
  .rbtn:hover:not(:disabled) { transform: translateY(-3px); }
  .rbtn:active:not(:disabled) { transform: translateY(-1px) scale(0.98); }
  .rbtn:disabled { opacity: 0.38; cursor: not-allowed; transform: none !important; }

  .rbtn-ver {
    background: linear-gradient(135deg, #6e96c3 0%, #4d7bae 100%);
    color: #ffffff !important; flex: 1;
    box-shadow: 0 4px 14px rgba(78,123,174,0.4);
  }
  .rbtn-ver:hover:not(:disabled) { box-shadow: 0 8px 24px rgba(78,123,174,0.6); }

  .rbtn-ok {
    background: linear-gradient(135deg, #a3ccb0 0%, #72b088 100%);
    color: #1a2f22 !important;
    box-shadow: 0 4px 14px rgba(114,176,136,0.35);
  }
  .rbtn-ok:hover:not(:disabled) { box-shadow: 0 8px 24px rgba(114,176,136,0.55); }

  .rbtn-cambiar {
    background: rgba(255,255,255,0.08); color: #e0ecf4 !important;
    border: 1.5px solid rgba(255,255,255,0.2) !important;
    backdrop-filter: blur(8px);
  }
  .rbtn-cambiar:hover:not(:disabled) {
    background: rgba(255,255,255,0.16);
    border-color: rgba(255,255,255,0.32) !important;
    box-shadow: 0 4px 16px rgba(255,255,255,0.1);
  }

  .rbtn-girar {
    background: linear-gradient(135deg, #2a6496 0%, #1e4d78 100%);
    color: #ffffff !important;
    padding: 15px 48px !important; font-size: 15px !important; border-radius: 28px !important;
    box-shadow: 0 4px 20px rgba(30,77,120,0.5);
    letter-spacing: 0.5px;
  }
  .rbtn-girar:hover:not(:disabled) {
    background: linear-gradient(135deg, #3478b0 0%, #2860a0 100%);
    box-shadow: 0 10px 32px rgba(30,77,120,0.7);
  }
</style>

<style>
  /* ── HEADER ── */
  .r-header {
    position: sticky; top: 0; z-index: 100;
    background: var(--white);
    box-shadow: 0 2px 16px rgba(40,49,67,0.06);
  }
  .r-header-inner {
    max-width: 1280px; margin: 0 auto;
    padding: 0 80px; height: 72px;
    display: flex; align-items: center; justify-content: space-between;
  }
  .r-logo {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-weight: 800; font-size: 20px;
    text-decoration: none; color: var(--navy);
    display: flex; align-items: center; gap: 10px;
  }
  .r-logo-img {
    width: 40px; height: 40px; border-radius: 10px;
    object-fit: contain;
  }
  .r-badge-header {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(110,150,195,0.1); color: #5b7fb5;
    padding: 6px 16px; border-radius: 20px;
    font-size: 12px; font-weight: 600;
  }

  /* ── HERO ── */
  .r-hero {
    background: linear-gradient(121deg, #3b4d6d 0%, var(--blue) 60%, var(--blue-mid) 100%);
    padding: 56px 80px 48px;
    display: flex; align-items: center;
    justify-content: center; gap: 48px; flex-wrap: wrap;
  }
  .r-hero-text {
    max-width: 480px;
    display: flex; flex-direction: column; gap: 16px;
  }
  .r-hero-badge {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(163,204,176,0.15); color: var(--green);
    padding: 6px 16px; border-radius: 20px;
    font-size: 12px; font-weight: 600; width: fit-content;
    animation: rFadeUp 0.5s ease both;
  }
  .r-hero-badge-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--green); flex-shrink: 0;
    animation: rPulse 2s ease-in-out infinite;
  }
  .r-hero-text h1 {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 52px; font-weight: 800; line-height: 1.05;
    color: var(--white);
    animation: rFadeUp 0.5s 0.1s ease both;
  }
  .r-hero-text p {
    color: var(--blue-light); font-size: 15px; line-height: 1.7;
    animation: rFadeUp 0.5s 0.2s ease both;
  }
  .r-mascot {
    width: 200px; height: 200px; flex-shrink: 0;
    filter: drop-shadow(0 8px 24px rgba(0,0,0,0.45));
    animation: rSlideIn 0.7s 0.2s ease both, rFloat 4s 1s ease-in-out infinite;
  }

  /* ── MAIN GAME ── */
  .r-game {
    max-width: 1200px; margin: 0 auto;
    padding: 56px 40px 80px;
    display: flex; align-items: flex-start;
    justify-content: center; gap: 56px; flex-wrap: wrap;
  }

  /* ── WHEEL COLUMN ── */
  .r-wheel-col {
    display: flex; flex-direction: column;
    align-items: center; gap: 24px; flex-shrink: 0;
  }
  .r-wheel-label {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 11px; font-weight: 700; letter-spacing: 2px;
    text-transform: uppercase; color: var(--blue-light);
    opacity: 0.7;
  }
  .r-wheel-wrap {
    position: relative; width: 540px; height: 540px;
  }
  .r-pointer {
    position: absolute; top: -20px; left: 50%;
    transform: translateX(-50%); z-index: 10;
    filter: drop-shadow(0 4px 12px rgba(0,0,0,0.6));
  }
  #r-canvas {
    display: block; border-radius: 50%;
    box-shadow:
      0 0 0 8px rgba(255,255,255,0.07),
      0 0 0 14px rgba(255,255,255,0.03),
      0 32px 80px rgba(0,0,0,0.7);
  }
  .r-spin-btn {
    position: absolute; top: 50%; left: 50%;
    transform: translate(-50%,-50%);
    width: 96px; height: 96px; border-radius: 50%;
    background: transparent;
    border: none;
    cursor: pointer;
    z-index: 5;
    transition: transform 0.15s;
  }
  .r-spin-btn:hover:not(:disabled) {
    transform: translate(-50%,-50%) scale(1.08);
  }
  .r-spin-btn:disabled { opacity: 0.55; cursor: not-allowed; transform: translate(-50%,-50%); }

  /* ── RESULT COLUMN ── */
  .r-result-col { flex: 1; min-width: 320px; max-width: 520px; }

  /* idle */
  .r-idle {
    border-radius: 28px; padding: 48px 36px;
    text-align: center;
    display: flex; flex-direction: column; align-items: center; gap: 16px;
    border: 1.5px dashed rgba(255,255,255,0.12);
    background: rgba(255,255,255,0.04);
  }
  .r-idle .r-idle-emoji { font-size: 56px; }
  .r-idle h3 {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 22px; font-weight: 800; color: var(--white);
  }
  .r-idle p { color: var(--blue-light); font-size: 14px; line-height: 1.7; max-width: 320px; }

  /* result card */
  .r-card {
    border-radius: 28px; padding: 32px 36px;
    display: flex; flex-direction: column; gap: 20px;
    border: 1.5px solid rgba(255,255,255,0.12);
    background: rgba(255,255,255,0.07);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .r-card.oculto  { opacity: 0; transform: translateY(20px); pointer-events: none; display: none; }
  .r-card.visible { opacity: 1; transform: translateY(0); display: flex; }

  /* slot header */
  .r-slot-head { display: flex; align-items: center; gap: 16px; }
  .r-slot-emoji { font-size: 44px; line-height: 1; flex-shrink: 0; }
  .r-slot-name {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 24px; font-weight: 800; line-height: 1.1;
  }
  .r-slot-desc { font-size: 13px; color: var(--blue-light); margin-top: 4px; }
  .r-sep { height: 1px; background: rgba(255,255,255,0.1); }

  /* pregunta */
  .r-q { display: flex; flex-direction: column; gap: 16px; }
  .r-q-meta { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }

  .r-tag {
    padding: 4px 12px; border-radius: 20px;
    font-size: 11px; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase;
  }
  .r-tag.farmaco { background: rgba(110,150,195,0.2); color: var(--blue-light); }
  .r-tag.anatom  { background: rgba(163,204,176,0.2); color: var(--green); }
  .r-tag.dificil { background: rgba(242,139,130,0.2); color: var(--red); }

  .r-timer {
    margin-left: auto;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 26px; font-weight: 800; color: var(--white);
    min-width: 60px; text-align: right;
  }
  .r-timer.urgente { color: var(--red); animation: rPulse 0.5s ease-in-out infinite; }

  .r-segunda-label {
    font-size: 11px; font-weight: 700; letter-spacing: 1px;
    text-transform: uppercase; color: var(--green);
    padding: 4px 0;
  }

  .r-q-texto {
    font-size: 16px; line-height: 1.75; color: var(--white);
    font-weight: 500;
  }

  .r-pista {
    background: rgba(163,204,176,0.1);
    border: 1px solid rgba(163,204,176,0.22);
    border-radius: 14px; padding: 14px 18px;
    font-size: 13px; color: var(--green); line-height: 1.6;
  }

  /* respuesta — oculta por defecto */
  .r-resp {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 14px; padding: 18px 22px;
    font-size: 14px; line-height: 1.7; color: var(--blue-light);
    display: none; /* SIEMPRE oculto hasta revelar */
  }
  .r-resp.mostrar {
    display: block;
    animation: rFadeUp 0.3s ease;
  }
  .r-resp-label {
    display: block; color: var(--green);
    font-size: 10px; font-weight: 800; letter-spacing: 1.5px;
    text-transform: uppercase; margin-bottom: 8px;
  }

  /* botones */
  .r-acciones { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 4px; }

  /* turno perdido */
  .r-perdido {
    text-align: center; padding: 8px 0;
    display: flex; flex-direction: column; align-items: center; gap: 12px;
  }
  .r-perdido .rp-emoji { font-size: 56px; }
  .r-perdido h3 {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 24px; font-weight: 800; color: var(--white);
  }
  .r-perdido p { font-size: 14px; color: var(--blue-light); }
  .r-girar-wrap { display: flex; justify-content: center; margin-top: 8px; }

  /* animaciones */
  @keyframes rFadeUp {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: none; }
  }
  @keyframes rSlideIn {
    from { opacity: 0; transform: translateX(48px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  @keyframes rFloat {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-14px); }
  }
  @keyframes rPulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50%       { transform: scale(1.1); opacity: 0.7; }
  }

  /* responsive */
  @media (max-width: 1024px) {
    .r-header-inner { padding: 0 40px; }
    .r-hero { padding: 40px; }
    .r-game { padding: 40px 24px 60px; gap: 40px; }
    .r-wheel-wrap { width: 440px; height: 440px; }
    #r-canvas { width: 440px !important; height: 440px !important; }
  }
  @media (max-width: 768px) {
    .r-header-inner { padding: 0 20px; }
    .r-hero { padding: 32px 20px; gap: 20px; }
    .r-hero-text h1 { font-size: 36px; }
    .r-mascot { width: 130px; height: 130px; }
    .r-wheel-wrap { width: 320px; height: 320px; }
    #r-canvas { width: 320px !important; height: 320px !important; }
    .r-spin-btn { width: 68px; height: 68px; font-size: 10px; }
    .r-game { padding: 28px 16px 60px; gap: 24px; }
    .r-card, .r-idle { padding: 24px 20px; }
  }
</style>

<!-- fuentes extra para estilos de cada sector -->
<link href="https://fonts.googleapis.com/css2?family=Pacifico&family=Nunito:wght@800&family=Creepster&family=Bebas+Neue&family=Righteous&family=Oswald:wght@600;700&family=Merriweather:ital,wght@0,700;1,400&display=swap" rel="stylesheet" />

<!-- HEADER -->
<header class="r-header">
  <div class="r-header-inner">
    <a href="/" class="r-logo">
      <img src="/logoTopoQuizz.png" alt="TopoQuizz" class="r-logo-img" />
      <span><span style="color:var(--red)">Topo</span><span style="color:var(--green)">Quizz</span></span>
    </a>
    <span class="r-badge-header">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
      Ruleta Médica
    </span>
  </div>
</header>

<!-- HERO -->
<div class="r-hero">
  <div class="r-hero-text">
    <div class="r-hero-badge">
      <span class="r-hero-badge-dot"></span>
      Modo Multijugador
    </div>
    <h1>Ruleta<br/>Médica</h1>
    <p>Gira la ruleta y enfrenta el destino. ¿Posturno, emergencia o pregunta mortal? ¡Solo los mejores médicos sobreviven!</p>
  </div>
  <div class="r-mascot" id="r-mascot"></div>
</div>

<!-- JUEGO -->
<div class="r-game">

  <!-- RULETA -->
  <div class="r-wheel-col">
    <span class="r-wheel-label">Gira la ruleta</span>
    <div class="r-wheel-wrap">
      <svg class="r-pointer" width="36" height="42" viewBox="0 0 36 42">
        <polygon points="18,42 0,6 36,6" fill="white" stroke="rgba(0,0,0,0.25)" stroke-width="1.5"/>
        <circle cx="18" cy="8" r="7" fill="white" stroke="rgba(0,0,0,0.25)" stroke-width="1.5"/>
      </svg>
      <canvas id="r-canvas" width="540" height="540"></canvas>
      <button class="r-spin-btn" id="r-spin-btn" aria-label="Girar ruleta"></button>
    </div>
  </div>

  <!-- RESULTADO -->
  <div class="r-result-col">

    <div class="r-idle" id="r-idle">
      <div class="r-idle-emoji">
        <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="rgba(110,150,195,0.7)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M19.07 4.93l-2.83 2.83M7.76 16.24l-2.83 2.83"/><circle cx="12" cy="12" r="3"/></svg>
      </div>
      <h3>¿Estás listo?</h3>
      <p>Presiona el botón central de la ruleta o el de abajo para comenzar. Cada sector tiene un efecto especial.</p>
      <button class="rbtn rbtn-girar" id="r-idle-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8M3 12l-2-2m2 2 2-2M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16m18-4 2 2m-2-2-2 2"/></svg>
        Girar la ruleta
      </button>
    </div>

    <div class="r-card oculto" id="r-card">
      <div class="r-slot-head">
        <div class="r-slot-emoji" id="r-slot-emoji"></div>
        <div>
          <div class="r-slot-name" id="r-slot-name"></div>
          <div class="r-slot-desc" id="r-slot-desc"></div>
        </div>
      </div>
      <div class="r-sep"></div>
      <div id="r-dyn"></div>
    </div>

  </div>
</div>

<!-- SCRIPT DE DATOS Y JUEGO (is:inline para evitar scoping) -->
<script is:inline>
(function() {

/* Lucide SVG paths (viewBox 0 0 24 24, stroke-based) */
var ICONS = {
  /* RefreshCw */
  posturno:      'M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8M3 12l-2-2m2 2 2-2M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16m18-4 2 2m-2-2-2 2',
  /* Stethoscope */
  doctor:        'M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3M14 15a6 6 0 0 0 6 6v0M20 21a2 2 0 1 0 0-4 2 2 0 0 0 0 4',
  /* Skull (calavera completa) */
  mortal:        'M12 2a8 8 0 0 0-8 8c0 3.19 1.87 5.95 4.6 7.28A1 1 0 0 1 9 18.28V20a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1v-1.72a1 1 0 0 1 .4-.82A8 8 0 0 0 12 2zm-2 11a1 1 0 1 1 0-2 1 1 0 0 1 0 2zm4 0a1 1 0 1 1 0-2 1 1 0 0 1 0 2z',
  /* HeartPulse */
  critico:       'M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7ZM3.22 12H9.5l1.5-3 2 4.5 1.5-2.5H21',
  /* Moon (guardia nocturna) */
  guardia:       'M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z',
  /* Siren / AlertTriangle */
  emergencia:    'M12 9v4M12 17h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z',
  /* FileSignature */
  consentimiento:'M20 19.5v.5a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8.5L18 5.5M15 2v4h4M12 12H8M16 16H8M10 8H8',
};

/* SVG completo para usar en HTML (tarjeta resultado, idle) */
function svgIcon(id, size, color) {
  size = size || 28; color = color || 'currentColor';
  return '<svg xmlns="http://www.w3.org/2000/svg" width="' + size + '" height="' + size + '" viewBox="0 0 24 24" fill="none" stroke="' + color + '" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="' + ICONS[id] + '"/></svg>';
}

var SLOTS = [
  {
    id:"posturno", label:"Posturno", desc:"¡Gira otra vez!",
    color:"#6e96c3",
    font:"'Pacifico', cursive",
    cardBg:"linear-gradient(135deg,#1a2f4e 0%,#223a5e 100%)",
    cardBorder:"rgba(110,150,195,0.35)",
    nameStyle:"font-size:28px;letter-spacing:1px;",
  },
  {
    id:"doctor", label:"Dr. Buena Onda", desc:"Recibes una pista",
    color:"#a3ccb0",
    font:"'Nunito', sans-serif",
    cardBg:"linear-gradient(135deg,#1a3028 0%,#1e3d2f 100%)",
    cardBorder:"rgba(163,204,176,0.35)",
    nameStyle:"font-size:26px;font-weight:800;letter-spacing:0.5px;",
  },
  {
    id:"mortal", label:"Pregunta mortal", desc:"",
    color:"#f28b82",
    font:"'Creepster', cursive",
    cardBg:"linear-gradient(135deg,#2d1515 0%,#3d1a1a 100%)",
    cardBorder:"rgba(242,139,130,0.4)",
    nameStyle:"font-size:32px;letter-spacing:2px;text-shadow:0 0 12px rgba(242,139,130,0.5);",
  },
  {
    id:"critico", label:"Paciente crítico", desc:"Pierdes tu turno",
    color:"#d27067",
    font:"'Bebas Neue', cursive",
    cardBg:"linear-gradient(135deg,#2d1010 0%,#3a1515 100%)",
    cardBorder:"rgba(210,112,103,0.4)",
    nameStyle:"font-size:36px;letter-spacing:4px;",
  },
  {
    id:"guardia", label:"Toca guardia", desc:"2 preguntas seguidas",
    color:"#e8c840",
    font:"'Righteous', cursive",
    cardBg:"linear-gradient(135deg,#2a2510 0%,#332d12 100%)",
    cardBorder:"rgba(232,200,64,0.35)",
    nameStyle:"font-size:28px;letter-spacing:1px;",
  },
  {
    id:"emergencia", label:"Emergencia médica", desc:"Responde en solo 20 segundos",
    color:"#ff6b6b",
    font:"'Oswald', sans-serif",
    cardBg:"linear-gradient(135deg,#2d1a10 0%,#3d2015 100%)",
    cardBorder:"rgba(255,107,107,0.4)",
    nameStyle:"font-size:30px;letter-spacing:2px;font-weight:700;text-transform:uppercase;",
  },
  {
    id:"consentimiento", label:"Consentimiento", desc:"Puedes cambiar de pregunta",
    color:"#8ab0d0",
    font:"'Merriweather', serif",
    cardBg:"linear-gradient(135deg,#162030 0%,#1a2a3e 100%)",
    cardBorder:"rgba(138,176,208,0.35)",
    nameStyle:"font-size:24px;font-style:italic;letter-spacing:0.5px;",
  },
