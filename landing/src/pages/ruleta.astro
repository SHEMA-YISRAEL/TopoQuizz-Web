/* ─── CANVAS ─── */
var cv  = document.getElementById('r-canvas');
var ctx = cv.getContext('2d');
var N   = SLOTS.length;
var ARC = (2 * Math.PI) / N;

/* outer ring decoration */
function drawWheel(angle) {
  var cx = cv.width / 2, cy = cv.height / 2, r = cx - 6;

  ctx.clearRect(0, 0, cv.width, cv.height);

  /* outer decorative rings */
  ctx.beginPath();
  ctx.arc(cx, cy, r + 10, 0, 2 * Math.PI);
  ctx.fillStyle = 'rgba(255,255,255,0.05)';
  ctx.fill();
  ctx.beginPath();
  ctx.arc(cx, cy, r + 5, 0, 2 * Math.PI);
  ctx.strokeStyle = 'rgba(255,255,255,0.18)';
  ctx.lineWidth = 3;
  ctx.stroke();

  for (var i = 0; i < N; i++) {
    var start = angle + i * ARC;
    var end   = start + ARC;
    var mid   = start + ARC / 2;

    /* slice */
    ctx.beginPath();
    ctx.moveTo(cx, cy);
    ctx.arc(cx, cy, r, start, end);
    ctx.closePath();
    ctx.fillStyle = SLOTS[i].color;
    ctx.fill();

    /* border */
    ctx.strokeStyle = 'rgba(0,0,0,0.22)';
    ctx.lineWidth = 2;
    ctx.stroke();

    /* inner highlight arc */
    ctx.save();
    ctx.beginPath();
    ctx.moveTo(cx, cy);
    ctx.arc(cx, cy, r, start, end);
    ctx.closePath();
    ctx.clip();
    var gr = ctx.createRadialGradient(cx, cy, r * 0.3, cx, cy, r);
    gr.addColorStop(0, 'rgba(255,255,255,0.18)');
    gr.addColorStop(1, 'rgba(0,0,0,0.0)');
    ctx.fillStyle = gr;
    ctx.fill();
    ctx.restore();

    /* text — centrado en el sector, radiando desde el borde hacia el hub */
    ctx.save();
    ctx.translate(cx, cy);
    ctx.rotate(mid);

    /* punto medio del sector: entre el hub (r=50) y el borde (r) */
    var innerR = 52;
    var textR  = innerR + (r - innerR) * 0.58; /* ~58% del camino desde el hub */

    ctx.textAlign    = 'center';
    ctx.textBaseline = 'middle';

    /* sombra suave para legibilidad */
    ctx.shadowColor  = 'rgba(0,0,0,0.5)';
    ctx.shadowBlur   = 6;
    ctx.shadowOffsetX = 0;
    ctx.shadowOffsetY = 2;

    /* icono Lucide — arriba del texto */
    var iconSize = 20;
    var iconPath = new Path2D(ICONS[SLOTS[i].id]);
    ctx.save();
    /* mover al punto textR,-16 y escalar de 24px viewBox a iconSize */
    var sc = iconSize / 24;
    ctx.translate(textR - iconSize / 2, -16 - iconSize / 2);
    ctx.scale(sc, sc);
    ctx.strokeStyle = 'rgba(255,255,255,0.95)';
    ctx.lineWidth   = 2 / sc;
    ctx.lineCap     = 'round';
    ctx.lineJoin    = 'round';
    ctx.shadowColor = 'rgba(0,0,0,0.6)';
    ctx.shadowBlur  = 8 / sc;
    ctx.stroke(iconPath);
    ctx.restore();

    /* etiqueta — debajo del icono */
    ctx.font = 'bold 15px "Plus Jakarta Sans", Inter, sans-serif';
    ctx.fillStyle = '#e7e7e7';
    ctx.shadowColor  = 'rgba(0,0,0,0.7)';
    ctx.shadowBlur   = 21;
    var words = SLOTS[i].label.split(' ');
    if (words.length === 1) {
      ctx.fillText(words[0], textR, 12);
    } else if (words.length === 2) {
      ctx.fillText(words[0], textR, 6);
      ctx.fillText(words[1], textR, 24);
    } else {
      var h = Math.ceil(words.length / 2);
      ctx.fillText(words.slice(0, h).join(' '), textR, 6);
      ctx.fillText(words.slice(h).join(' '),    textR, 24);
    }

    ctx.shadowColor = 'transparent';
    ctx.restore();
  }

  /* center hub — outer glow ring */
  ctx.beginPath();
  ctx.arc(cx, cy, 52, 0, 2 * Math.PI);
  ctx.fillStyle = 'rgba(0,0,0,0.3)';
  ctx.fill();

  /* hub fill */
  var hubGr = ctx.createRadialGradient(cx, cy, 0, cx, cy, 48);
  hubGr.addColorStop(0, '#3b4d6d');
  hubGr.addColorStop(1, '#161d1d');
  ctx.beginPath();
  ctx.arc(cx, cy, 48, 0, 2 * Math.PI);
  ctx.fillStyle = hubGr;
  ctx.fill();

  /* hub border */
  ctx.strokeStyle = 'rgba(255,255,255,0.22)';
  ctx.lineWidth = 2.5;
  ctx.stroke();

  /* hub inner border */
  ctx.beginPath();
  ctx.arc(cx, cy, 42, 0, 2 * Math.PI);
  ctx.strokeStyle = 'rgba(255,255,255,0.08)';
  ctx.lineWidth = 1;
  ctx.stroke();

  /* hub text — GIRAR */
  ctx.font = 'bold 11px "Plus Jakarta Sans", Inter, sans-serif';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillStyle = 'rgba(255,255,255,0.9)';
  ctx.shadowColor = 'rgba(0,0,0,0.5)';
  ctx.shadowBlur = 4;
  ctx.fillText('GIRAR', cx, cy);
  ctx.shadowColor = 'transparent';
}

var currentAngle = -Math.PI / 2;
var spinning = false;
/* esperar a que las fuentes decorativas carguen antes del primer draw */
document.fonts.ready.then(function() { drawWheel(currentAngle); });

/* ─── SPIN ─── */
var spinBtn  = document.getElementById('r-spin-btn');
var idleEl   = document.getElementById('r-idle');
var cardEl   = document.getElementById('r-card');

function girar() {
  if (spinning) return;
  spinning = true;
  spinBtn.disabled = true;
  idleEl.style.display = 'none';
  cardEl.classList.remove('visible');
  cardEl.classList.add('oculto');

  var sector = Math.floor(Math.random() * N);
  var from   = currentAngle;

  /* ángulo final donde debe quedar el puntero (centro del sector elegido) */
  var finalAngle = -(sector * ARC + ARC / 2) - Math.PI / 2;

  /* normalizar finalAngle para que esté "adelante" de from */
  var normalizedFinal = finalAngle % (2 * Math.PI);
  var normalizedFrom  = from % (2 * Math.PI);
  var shortDelta = ((normalizedFinal - normalizedFrom) % (2 * Math.PI) + 2 * Math.PI) % (2 * Math.PI);

  /* garantizar mínimo 5 vueltas completas + el arco hasta el sector */
  var minVueltas = 5;
  var extra = minVueltas + Math.floor(Math.random() * 4); /* 5–8 vueltas */
  var delta = shortDelta + extra * 2 * Math.PI;

  var target = from + delta;
  var dur    = 4000 + Math.random() * 1500;
  var t0     = performance.now();

  function ease(t) { return 1 - Math.pow(1 - t, 4); }

  function frame(now) {
    var t = Math.min((now - t0) / dur, 1);
    drawWheel(from + delta * ease(t));
    if (t < 1) { requestAnimationFrame(frame); }
    else {
      currentAngle = target % (2 * Math.PI);
      spinning = false;
      spinBtn.disabled = false;
      mostrarResultado(sector);
    }
  }
  requestAnimationFrame(frame);
}

spinBtn.addEventListener('click', girar);
document.getElementById('r-idle-btn').addEventListener('click', girar);

/* ─── PREGUNTAS ─── */
var usadasN = [], usadasD = [];
var timerID = null, modoDoble = false, puedeCambiar = false;

function elegir(dificil) {
  var pool  = PREGUNTAS.filter(function(p){ return p.dificil === dificil; });
  var usadas = dificil ? usadasD : usadasN;
  var libres = pool.map(function(_,i){ return i; }).filter(function(i){ return usadas.indexOf(i) < 0; });
  if (!libres.length) { libres = pool.map(function(_,i){ return i; }); if(dificil) usadasD=[]; else usadasN=[]; }
  var pick = libres[Math.floor(Math.random() * libres.length)];
  if (dificil) usadasD.push(pick); else usadasN.push(pick);
  return pool[pick];
}

function calcPista(q) {
  return '💡 Pista: «' + q.resp.split(' ').slice(0, 6).join(' ') + '…»';
}

function pararTimer() {
  if (timerID) { clearInterval(timerID); timerID = null; }
}

function iniciarTimer(segs) {
  pararTimer();
  var el = document.getElementById('r-timer');
  if (!el) return;
  var rem = segs;
  el.textContent = rem + 's';
  el.classList.remove('urgente');
  timerID = setInterval(function(){
    rem--;
    var t = document.getElementById('r-timer');
    if (t) { t.textContent = rem + 's'; if (rem <= 5) t.classList.add('urgente'); }
    if (rem <= 0) { pararTimer(); revelar(); var t2=document.getElementById('r-timer'); if(t2){t2.textContent='⏰';t2.classList.add('urgente');} }
  }, 1000);
}

function revelar() {
  var r = document.getElementById('r-resp');
  var b = document.getElementById('r-btn-ver');
  if (r) { r.style.display = 'block'; r.classList.add('mostrar'); }
  if (b) b.disabled = true;
}

