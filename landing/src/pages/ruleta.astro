var S_TAG_DIFIC  = S_TAG_BASE + 'background:rgba(242,139,130,0.2);color:#f28b82;';

function tag(q) {
  if (q.dificil) return '<span style="' + S_TAG_DIFIC + '">Difícil</span>';
  if (q.cat === 'Farmacología') return '<span style="' + S_TAG_FARM + '">Farmacología</span>';
  return '<span style="' + S_TAG_ANAT + '">Anatomía</span>';
}

function renderQ(q, opts) {
  opts = opts || {};
  var dyn = document.getElementById('r-dyn');

  /* contenedor principal */
  var wrap = document.createElement('div');
  wrap.style.cssText = 'display:flex;flex-direction:column;gap:16px;';

  /* segunda pregunta label */
  if (opts.segunda) {
    var seg = document.createElement('div');
    seg.style.cssText = 'font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:#a3ccb0;padding:4px 0;';
    seg.textContent = '⚡ Segunda pregunta — Toca Guardia';
    wrap.appendChild(seg);
  }

  /* fila tag + timer */
  var fila = document.createElement('div');
  fila.style.cssText = 'display:flex;align-items:center;gap:10px;flex-wrap:wrap;';
  fila.innerHTML = tag(q);
  if (opts.timer) {
    var timer = document.createElement('span');
    timer.id = 'r-timer';
    timer.style.cssText = 'margin-left:auto;font-family:"Plus Jakarta Sans",Inter,sans-serif;font-size:26px;font-weight:800;color:#ffffff;min-width:60px;text-align:right;';
    timer.textContent = '20s';
    fila.appendChild(timer);
  }
  wrap.appendChild(fila);

  /* pregunta */
  var pregEl = document.createElement('div');
  pregEl.style.cssText = 'font-size:16px;line-height:1.75;color:#ffffff;font-weight:500;';
  pregEl.textContent = q.texto;
  wrap.appendChild(pregEl);

  /* pista */
  if (opts.pista) {
    var pista = document.createElement('div');
    pista.style.cssText = 'background:rgba(163,204,176,0.1);border:1px solid rgba(163,204,176,0.22);border-radius:14px;padding:14px 18px;font-size:13px;color:#a3ccb0;line-height:1.6;';
    pista.textContent = calcPista(q);
    wrap.appendChild(pista);
  }

  /* respuesta (oculta) */
  var resp = document.createElement('div');
  resp.id = 'r-resp';
  resp.style.cssText = 'display:none;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:14px;padding:18px 22px;font-size:14px;line-height:1.7;color:#a8c6dd;';
  var label = document.createElement('span');
  label.style.cssText = 'display:block;color:#a3ccb0;font-size:10px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:8px;';
  label.textContent = 'Respuesta';
  resp.appendChild(label);
  resp.appendChild(document.createTextNode(q.resp));
  wrap.appendChild(resp);

  /* acciones */
  var acc = document.createElement('div');
  acc.id = 'r-acciones';
  acc.style.cssText = 'display:flex;gap:10px;flex-wrap:wrap;margin-top:4px;';

  var bVer = mkBtn('rbtn-ver', SVG_VER + ' Ver respuesta', 'r-btn-ver');
  acc.appendChild(bVer);

  if (opts.cambiar) {
    var bCambiar = mkBtn('rbtn-cambiar', SVG_CAMBIAR + ' Cambiar pregunta', 'r-btn-cambiar');
    acc.appendChild(bCambiar);
  }

  wrap.appendChild(acc);
  dyn.innerHTML = '';
  dyn.appendChild(wrap);

  document.getElementById('r-btn-ver').addEventListener('click', function(){
    pararTimer();
    revelar();
    var accEl = document.getElementById('r-acciones');
    if (modoDoble && !opts.segunda) {
      var b2 = mkBtn('rbtn-ok', SVG_RAYO + ' Segunda pregunta');
      b2.addEventListener('click', function(){ modoDoble = false; renderQ(elegir(false), { segunda: true }); });
      accEl.appendChild(b2);
    } else {
      var bOk = mkBtn('rbtn-ok', SVG_OK + ' Listo, siguiente turno');
      bOk.addEventListener('click', resetear);
      accEl.appendChild(bOk);
    }
  });

  var bcEl = document.getElementById('r-btn-cambiar');
  if (bcEl) {
    bcEl.addEventListener('click', function(){
      if (!puedeCambiar) return;
      puedeCambiar = false; renderQ(elegir(false), {});
    });
  }

  if (opts.timer) iniciarTimer(20);
}

function resetear() {
  pararTimer(); modoDoble = false; puedeCambiar = false;
  var dyn = document.getElementById('r-dyn');
  dyn.innerHTML = '';

  var wrap = document.createElement('div');
  wrap.style.cssText = 'display:flex;flex-direction:column;align-items:center;gap:14px;padding:8px 0 4px;';

  var txt = document.createElement('p');
  txt.style.cssText = 'color:#a8c6dd;font-size:14px;text-align:center;line-height:1.6;';
  txt.textContent = '¡Buen trabajo! Gira de nuevo para el siguiente turno.';
  wrap.appendChild(txt);

  var bNuevo = mkBtn('rbtn-girar', SVG_GIRAR + ' Girar de nuevo', 'r-btn-nuevo');
  bNuevo.addEventListener('click', girar);
  wrap.appendChild(bNuevo);

  dyn.appendChild(wrap);
}

/* ─── RESULTADO ─── */
function mostrarResultado(idx) {
  var s = SLOTS[idx];
  /* header */
  document.getElementById('r-slot-emoji').innerHTML = svgIcon(s.id, 44, s.color);

  var nameEl = document.getElementById('r-slot-name');
  nameEl.textContent  = s.label;
  nameEl.setAttribute('style', 'font-family:' + s.font + ';color:' + s.color + ';line-height:1.1;' + s.nameStyle);

  var descEl = document.getElementById('r-slot-desc');
  descEl.textContent = s.desc;
  descEl.style.color = 'rgba(255,255,255,0.6)';

  /* card background */
  var card = document.getElementById('r-card');
  card.style.background = s.cardBg;
  card.style.borderColor = s.cardBorder;
  pararTimer(); modoDoble = false; puedeCambiar = false;

  var dyn = document.getElementById('r-dyn');
  dyn.innerHTML = '';

  function mkPerdido(slotId, titulo, desc, btnTxt) {
    var wrap = document.createElement('div');
    wrap.style.cssText = 'display:flex;flex-direction:column;align-items:center;gap:12px;text-align:center;padding:8px 0;';
    var em = document.createElement('div'); em.style.cssText = 'display:flex;align-items:center;justify-content:center;'; em.innerHTML = svgIcon(slotId, 56, s.color);
    var tit = document.createElement('span'); tit.style.cssText = 'font-family:"Plus Jakarta Sans",Inter,sans-serif;font-size:24px;font-weight:800;color:#ffffff;display:block;'; tit.textContent = titulo;
    var p = document.createElement('span'); p.style.cssText = 'font-size:14px;color:#c8dce8;display:block;'; p.textContent = desc;
    var btnWrap = document.createElement('div'); btnWrap.style.cssText = 'display:flex;justify-content:center;margin-top:8px;';
    var btn = mkBtn('rbtn-girar', SVG_GIRAR + ' ' + btnTxt);
    btn.addEventListener('click', girar);
    btnWrap.appendChild(btn);
    wrap.appendChild(em); wrap.appendChild(tit); wrap.appendChild(p); wrap.appendChild(btnWrap);
    dyn.appendChild(wrap);
  }

  if (s.id === 'posturno') {
    mkPerdido('posturno', '¡Posturno!', 'Giras otra vez sin parar.', 'Girar de nuevo');
  } else if (s.id === 'critico') {
    mkPerdido('critico', 'Paciente Crítico', 'Pierdes tu turno. El siguiente jugador continúa.', 'Siguiente turno');
  } else if (s.id === 'doctor') {
    renderQ(elegir(false), { pista: true });
  } else if (s.id === 'mortal') {
    renderQ(elegir(true), {});
  } else if (s.id === 'guardia') {
    modoDoble = true; renderQ(elegir(false), {});
  } else if (s.id === 'emergencia') {
    renderQ(elegir(false), { timer: true });
  } else if (s.id === 'consentimiento') {
    puedeCambiar = true; renderQ(elegir(false), { cambiar: true });
  }

  cardEl.classList.remove('oculto');
  cardEl.classList.add('visible');
}

})(); // IIFE
</script>

