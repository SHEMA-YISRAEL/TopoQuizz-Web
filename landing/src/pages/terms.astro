---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Terms of Service — TopoQuizz"
  description="Terms of Service for TopoQuizz. Read the terms and conditions governing use of our application."
>
  <Header />

  <main class="privacy-page">
