---
interface Props {
  text: string;
  url: string;
  textColor?: string;
}

const { text, url, textColor = "#6F96C3" } = Astro.props;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class='relative flex items-center rounded-full w-full h-[62px] border border-[#D7E4F2] bg-white px-5 py-2.5 cursor-pointer transition hover:shadow-[0_8px_20px_-4px_rgba(111,150,195,0.5)]'
>
  <span class="absolute left-5 flex items-center">
    <slot name="icon" />
  </span>
  <span class="flex-1 text-center font-semibold text-lg" style={`color: ${textColor}`}>{text}</span>
</a>
