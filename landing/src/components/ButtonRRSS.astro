---
interface Props {
  text: string;
  url: string;
  textColor?: string;
  comingSoon?: boolean;
}

const { text, url, textColor = "#6F96C3", comingSoon = false } = Astro.props;
const Tag = comingSoon ? "div" : "a";
---

<Tag
  href={comingSoon ? undefined : url}
  target={comingSoon ? undefined : "_blank"}
  rel={comingSoon ? undefined : "noopener noreferrer"}
  aria-disabled={comingSoon ? "true" : undefined}
  class:list={[
    "group relative flex items-center rounded-full w-full h-[62px] border border-[#D7E4F2] bg-white px-5 py-2.5 transition hover:shadow-[0_8px_20px_-4px_rgba(111,150,195,0.5)]",
    comingSoon ? "cursor-not-allowed" : "cursor-pointer",
  ]}
>
  <span class="absolute left-5 flex items-center">
    <slot name="icon" />
  </span>
  <span class="flex-1 text-center font-semibold text-lg" style={`color: ${textColor}`}>{text}</span>
  {comingSoon && (
    <span class="pointer-events-none absolute inset-0 flex items-center justify-center rounded-full bg-white/70 opacity-100 backdrop-blur-sm transition-opacity duration-200 sm:opacity-0 sm:group-hover:opacity-100">
      <span class="font-semibold text-lg text-[#6F96C3]">Próximamente</span>
    </span>
  )}
</Tag>
