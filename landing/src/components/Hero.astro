---
interface Props {
  appStoreUrl: string;
  playStoreUrl: string;
}
const { appStoreUrl, playStoreUrl } = Astro.props;
---

<section class="hero">
  <div class="hero-inner">
    <div class="hero-left">
      <div class="mascot-lottie" id="mascot-lottie"></div>
      <div class="badge beta-badge">
        <span class="badge-dot"></span>
        Disponible en Google Play
      </div>
      <h1>Practica Medicina jugando</h1>
      <p class="hero-sub">
        Ya disponible en Google Play. Quizzes de <strong>Anatomía</strong> y <strong>Farmacología</strong> — MUY PRONTO MÁS MATERIAS.
      </p>
      <div class="store-buttons">
        <a href={appStoreUrl} class="store-btn white soon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
          <div>
            <small>Próximamente en</small>
            <strong>App Store</strong>
          </div>
        </a>
        <a href={playStoreUrl} class="store-btn gplay" target="_blank" rel="noopener noreferrer">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 511.999 511.999" aria-hidden="true">
            <path d="M382.369,175.623C322.891,142.356,227.427,88.937,79.355,6.028C69.372-0.565,57.886-1.429,47.962,1.93l254.05,254.05L382.369,175.623z" fill="#32BBFF"/>
            <path d="M47.962,1.93c-1.86,0.63-3.67,1.39-5.401,2.308C31.602,10.166,23.549,21.573,23.549,36v439.96c0,14.427,8.052,25.834,19.012,31.761c1.728,0.917,3.537,1.68,5.395,2.314L302.012,255.98L47.962,1.93z" fill="#32BBFF"/>
            <path d="M302.012,255.98L47.956,510.035c9.927,3.384,21.413,2.586,31.399-4.103c143.598-80.41,237.986-133.196,298.152-166.746c1.675-0.941,3.316-1.861,4.938-2.772L302.012,255.98z" fill="#32BBFF"/>
            <path d="M79.355,6.028C67.5-1.8,53.52-1.577,42.561,4.239l255.595,255.596l84.212-84.212C322.891,142.356,227.427,88.937,79.355,6.028z" fill="#29CC5E"/>
            <path d="M298.158,252.126L42.561,507.721c10.96,5.815,24.939,6.151,36.794-1.789c143.598-80.41,237.986-133.196,298.152-166.746c1.675-0.941,3.316-1.861,4.938-2.772L298.158,252.126z" fill="#D93F21"/>
            <path d="M488.45,255.98c0-12.19-6.151-24.492-18.342-31.314c0,0-22.799-12.721-92.682-51.809l-83.123,83.123l83.204,83.205c69.116-38.807,92.6-51.892,92.6-51.892C482.299,280.472,488.45,268.17,488.45,255.98z" fill="#FFD500"/>
          </svg>
          <div>
            <small>Disponible en</small>
            <strong>Google Play</strong>
          </div>
        </a>
      </div>
    </div>
    <div class="hero-right">
      <div class="phone-mockup">
        <div class="phone-notch"></div>
        <img src={`${import.meta.env.BASE_URL}screenshots/init.png`} alt="TopoQuizz pantalla inicial" class="phone-img" />
      </div>
    </div>
  </div>
</section>

<script>
  import lottie from 'lottie-web';

  lottie.loadAnimation({
    container: document.getElementById('mascot-lottie') as HTMLElement,
    renderer: 'svg',
    loop: true,
    autoplay: true,
    path: `${import.meta.env.BASE_URL}HomeMole.json`,
  });
</script>
